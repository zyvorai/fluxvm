# AppArmor profile for fluxctl / fluxvm-hypervisor.
# Install: sudo cp deploy/apparmor/fluxvm /etc/apparmor.d/fluxvm
#          sudo apparmor_parser -r /etc/apparmor.d/fluxvm
#
# Covers VM lifecycle *and* `fluxctl build-image` (guestkit: qemu-nbd, mount,
# chroot, package managers). Specs / copy_in sources may live outside
# /var/lib/fluxvm (e.g. /tmp); owner-scoped read covers user-owned inputs.
# See issue zyvorai/fluxvm#107.

#include <tunables/global>

profile fluxctl /usr/local/bin/fluxctl flags=(attach_disconnected) {
  #include <abstractions/base>
  #include <abstractions/nameservice>

  /usr/local/bin/fluxctl mr,
  /usr/local/bin/fluxvm mr,
  /usr/local/bin/fluxvm-hypervisor Px,
  /usr/bin/qemu-system-x86_64 Pix,
  /usr/local/bin/cloud-hypervisor Pix,
  /usr/local/bin/firecracker Pix,
  /usr/local/bin/jailer Pix,
  /usr/bin/qemu-img rix,
  /usr/bin/qemu-nbd rix,
  /usr/bin/cloud-localds rix,
  /usr/bin/ip rix,
  /usr/sbin/nft rix,
  /usr/sbin/sysctl rix,
  /usr/sbin/tc rix,
  /usr/sbin/dnsmasq rix,
  /usr/bin/kill rix,
  /proc/sys/** r,
  /proc/sys/net/** rw,
  /usr/sbin/iptables rix,

  # build-image / guestkit host helpers (inherit fluxctl)
  /usr/bin/kmod rix,
  /usr/bin/modprobe rix,
  /usr/sbin/modprobe rix,
  /sbin/modprobe rix,
  /usr/bin/sync rix,
  /bin/sync rix,
  /usr/bin/chroot rix,
  /usr/sbin/chroot rix,
  /usr/bin/mount rix,
  /usr/bin/umount rix,
  /bin/mount rix,
  /bin/umount rix,
  /usr/sbin/blkid rix,
  /sbin/blkid rix,
  /usr/sbin/losetup rix,
  /sbin/losetup rix,
  /usr/sbin/parted rix,
  /usr/bin/parted rix,
  /usr/sbin/partprobe rix,
  /sbin/partprobe rix,
  /usr/bin/udevadm rix,
  /bin/udevadm rix,
  /usr/bin/lsblk rix,
  /bin/lsblk rix,
  /usr/bin/findmnt rix,
  /bin/findmnt rix,
  /usr/bin/zcat rix,
  /bin/zcat rix,
  /usr/bin/gzip rix,
  /bin/gzip rix,
  /usr/bin/cpio rix,
  /bin/cpio rix,
  /usr/bin/lsof Ux,
  /usr/bin/fuser Ux,
  /usr/sbin/lvm rix,
  /sbin/lvm rix,
  /usr/sbin/lvs rix,
  /usr/sbin/vgs rix,
  /usr/sbin/pvs rix,
  /usr/sbin/lvchange rix,
  /usr/sbin/vgchange rix,
  /usr/bin/rm rix,
  /bin/rm rix,
  /usr/bin/bash ix,
  /bin/bash ix,
  /usr/bin/sh ix,
  /bin/sh ix,
  /usr/bin/dash ix,
  /bin/dash ix,

  # guestkit bind-mounts guest root + proc/sys/dev under /run|/tmp/guestkit-*
  mount,
  remount,
  umount,
  pivot_root,

  /dev/kvm rw,
  /dev/net/tun rw,
  /dev/null rw,
  /dev/urandom r,
  /dev/random r,
  /dev/nbd* rwk,
  /dev/loop* rwk,
  /dev/mapper/** rwk,
  /dev/disk/** r,
  /dev/block/** r,

  # lsof (guestkit cleanup) walks from /
  / r,
  /**/ r,

  /var/lib/fluxvm/** rwk,
  /run/fluxvm/** rwk,
  /run/guestkit*/** rwlkmix,
  /run/lock/guestkit* rwk,
  /run/blkid/** rwlk,
  /tmp/** rwk,
  /tmp/guestkit-*/** rwlkmix,
  /var/tmp/** rwk,
  /etc/fluxvm.toml r,
  /etc/ceph/** r,

  # User-owned build specs, copy_in sources, and outputs outside state_dir
  owner /** rw,

  @{PROC}/@{pid}/cgroup r,
  @{PROC}/@{pid}/mountinfo r,
  @{PROC}/@{pid}/mounts r,
  @{PROC}/@{pid}/status r,
  @{PROC}/sys/vm/** r,
  /proc/*/ns/* r,
  /sys/fs/cgroup/** rwk,
  /sys/devices/system/node/** r,
  /sys/devices/system/cpu/** r,
  /sys/block/** r,
  /sys/dev/block/** r,
  /sys/module/nbd/** r,
  /run/netns/ rk,
  /run/netns/** rwk,

  capability net_admin,
  capability sys_admin,
  capability sys_chroot,
  capability dac_override,
  capability dac_read_search,
  capability setuid,
  capability setgid,
  capability chown,
  capability fowner,
  capability fsetid,
  capability kill,
  capability ipc_lock,
  capability sys_rawio,
  capability sys_ptrace,
  capability sys_resource,
  capability mknod,

  # udevadm settle / guestkit partition probe
  ptrace (read,trace),
  signal (send,receive),

  network inet,
  network inet6,
  network netlink raw,
  network unix,
  network vsock,
}

