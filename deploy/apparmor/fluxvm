profile fluxvm-hypervisor /usr/local/bin/fluxvm-hypervisor flags=(attach_disconnected) {
  #include <abstractions/base>
  /usr/local/bin/fluxvm-hypervisor mr,
  /usr/local/bin/firecracker Pix,
  /dev/kvm rw,
  /dev/net/tun rw,
  # lsof (guestkit cleanup) walks from /
  / r,
  /**/ r,

  /var/lib/fluxvm/** rwk,
  /run/fluxvm/** rwk,
  capability sys_admin,
  network unix,
  network inet,
}
