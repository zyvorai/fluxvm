# Example environment for containerd-shim-fluxvm-v2 (Secure Containers).
# Source from a systemd drop-in or containerd process environment.
#
# Required
# FLUXVM_API_URL=http://127.0.0.1:7788
# FLUXVM_CONTAINER_GUEST_IMAGE=/var/lib/fluxvm/images/secure-container.qcow2
# FLUXVM_CONTAINER_AGENT_BINARY=/usr/local/libexec/fluxvm-container-agent

# VMM: qemu (default) | cloud-hypervisor | firecracker
# FLUXVM_CONTAINER_BACKEND=qemu

# Firecracker needs a Linux kernel (or set firecracker_kernel on the FluxVM daemon)
# FLUXVM_CONTAINER_BACKEND=firecracker
# FLUXVM_CONTAINER_KERNEL=/var/lib/fluxvm/images/vmlinux

# CNI
# FLUXVM_CONTAINER_CNI=1
# FLUXVM_CONTAINER_CNI_PROVIDER=auto
# FLUXVM_CONTAINER_CNI_DATAPATH=auto
# FLUXVM_CONTAINER_CNI_MULTUS_DATAPATH=bridge

# hostPath allowlist (colon-separated) + optional hotplug broker (QEMU/CH)
# FLUXVM_HOSTPATH_ALLOW=/srv/shared
# FLUXVM_HOSTPATH_BROKER=1

# Warm pool (QEMU/CH only — Firecracker has no share hotplug)
# FLUXVM_CONTAINER_WARM_POOL=sc-warm
