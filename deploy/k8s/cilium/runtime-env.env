#
# Environment for containerd-shim-fluxvm-v2 on Cilium nodes.
# Source from a systemd EnvironmentFile= drop-in or export before containerd
# starts RuntimeClass=fluxvm pods. See README.md in this directory.

FLUXVM_CONTAINER_CNI=1
FLUXVM_CONTAINER_CNI_PROVIDER=auto
FLUXVM_CONTAINER_CNI_INTERFACE=eth0
FLUXVM_CONTAINER_CNI_STRICT_MULTI_INTERFACE=1
