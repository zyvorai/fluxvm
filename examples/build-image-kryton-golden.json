{
  "source": "/var/lib/fluxvm/images/windows-11e-golden.qcow2",
  "output": "/var/lib/fluxvm/images/windows-custom.qcow2",
  "format": "qcow2",
  "windows": {
    "hostname": "win-lab",
    "enable_rdp": true,
    "enable_winrm": false,
    "firewall_open": [
      { "name": "RDP", "port": 3389, "protocol": "tcp" },
      { "name": "ZyvorApp", "port": 8080, "protocol": "tcp" }
    ],
    "scripts": [
      {
        "name": "ready-marker",
        "powershell": true,
        "content": "New-Item -Path C:\\fluxvm-ready.txt -ItemType File -Force | Out-Null\r\nSet-Content -Path C:\\fluxvm-ready.txt -Value 'kryton-golden-guestkit-ok'\r\n"
      }
    ],
    "agent": {
      "binary": "/usr/lib/guestkit/guestkitd.exe",
      "virtio_serial_driver": "/usr/share/virtio-win/vioserial/w10/amd64"
    }
  },
  "_comment": "Source from Kryton: ./scripts/prepare-windows-golden.sh --build --version 11e (see docs/windows-golden.md)"
}
