{
  "name": "native-agent",
  "backend": "flux-vm",
  "image": "/var/lib/fluxvm/images/linux-agent.raw",
  "kernel": "/var/lib/fluxvm/kernels/vmlinux-5.10.225-no-acpi",
  "vcpus": 1,
  "memory_mib": 512,
  "network": { "mode": "none" },
  "ttl_seconds": 3600,
  "agent": { "enabled": true },
  "cloud_init": { "hostname": "native-agent" }
}
