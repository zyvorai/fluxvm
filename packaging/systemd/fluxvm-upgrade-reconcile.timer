[Unit]
Description=Periodically reconcile stale FluxVM Sentinel upgrades

[Timer]
OnBootSec=5min
OnUnitActiveSec=5min
RandomizedDelaySec=30s
Persistent=true
Unit=fluxvm-upgrade-reconcile.service

[Install]
WantedBy=timers.target
