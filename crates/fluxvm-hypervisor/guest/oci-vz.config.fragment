# Kernel for FluxVM OCI sandboxes on vz (Virtualization.framework, Apple silicon).
# Applied on top of `make ARCH=arm64 allnoconfig` by scripts/build-oci-boot.sh, which fails if any
# `=y` line below does not survive Kconfig dependency resolution. Everything is built in: no modules.
# Boot: VZLinuxBootLoader with the uncompressed arm64 Image and a zstd initramfs; console on hvc0.

# core
CONFIG_64BIT=y
CONFIG_ARM64_4K_PAGES=y
CONFIG_SMP=y
CONFIG_NR_CPUS=64
CONFIG_PREEMPT_VOLUNTARY=y
CONFIG_NO_HZ_IDLE=y
CONFIG_HIGH_RES_TIMERS=y
CONFIG_HZ_250=y
CONFIG_MULTIUSER=y
CONFIG_SYSVIPC=y
CONFIG_POSIX_MQUEUE=y
CONFIG_PRINTK=y
CONFIG_BUG=y
CONFIG_FUTEX=y
CONFIG_EPOLL=y
CONFIG_SIGNALFD=y
CONFIG_TIMERFD=y
CONFIG_EVENTFD=y
CONFIG_SHMEM=y
CONFIG_AIO=y
CONFIG_IO_URING=y
CONFIG_ADVISE_SYSCALLS=y
CONFIG_MEMBARRIER=y
CONFIG_FHANDLE=y
CONFIG_RSEQ=y
CONFIG_BINFMT_ELF=y
CONFIG_BINFMT_SCRIPT=y
# linux/amd64 images: init registers the Rosetta share for x86-64 ELF binaries
CONFIG_BINFMT_MISC=y
CONFIG_COMPAT=n
CONFIG_MODULES=n
CONFIG_KEXEC=n
CONFIG_HIBERNATION=n
CONFIG_SUSPEND=n
CONFIG_EFI=n
CONFIG_ACPI=n
CONFIG_KALLSYMS=n
CONFIG_DEBUG_KERNEL=n
CONFIG_CC_OPTIMIZE_FOR_PERFORMANCE=y

# initramfs (fluxvm-oci-init, guest agent, mke2fs)
CONFIG_BLK_DEV_INITRD=y
CONFIG_RD_ZSTD=y
CONFIG_RD_GZIP=y
CONFIG_DEVTMPFS=y
CONFIG_DEVTMPFS_MOUNT=y

# containers: cgroup v2, namespaces, seccomp, no_new_privs
CONFIG_CGROUPS=y
CONFIG_MEMCG=y
CONFIG_BLK_CGROUP=y
CONFIG_CGROUP_SCHED=y
CONFIG_FAIR_GROUP_SCHED=y
CONFIG_CGROUP_PIDS=y
CONFIG_CGROUP_FREEZER=y
CONFIG_CPUSETS=y
CONFIG_CGROUP_DEVICE=y
CONFIG_CGROUP_CPUACCT=y
CONFIG_NAMESPACES=y
CONFIG_UTS_NS=y
CONFIG_IPC_NS=y
CONFIG_USER_NS=y
CONFIG_PID_NS=y
CONFIG_NET_NS=y
CONFIG_SECCOMP=y
CONFIG_SECCOMP_FILTER=y
CONFIG_SECURITY=y

# platform: GICv3, PCIe ECAM host, PL031 RTC, entropy
CONFIG_ARM_GIC_V3=y
CONFIG_PCI=y
CONFIG_PCI_HOST_GENERIC=y
CONFIG_PCI_MSI=y
CONFIG_RTC_CLASS=y
CONFIG_RTC_HCTOSYS=y
CONFIG_RTC_DRV_PL031=y
CONFIG_HW_RANDOM=y
CONFIG_HW_RANDOM_VIRTIO=y

# virtio over PCI (vz exposes everything as virtio-pci)
CONFIG_VIRTIO_MENU=y
CONFIG_VIRTIO=y
CONFIG_VIRTIO_PCI=y
CONFIG_VIRTIO_BLK=y
CONFIG_VIRTIO_NET=y
CONFIG_VIRTIO_CONSOLE=y
CONFIG_VIRTIO_BALLOON=y
CONFIG_VSOCKETS=y
CONFIG_VIRTIO_VSOCKETS=y
CONFIG_FUSE_FS=y
CONFIG_VIRTIO_FS=y

# block, tty
CONFIG_BLOCK=y
CONFIG_BLK_DEV=y
CONFIG_TTY=y
CONFIG_UNIX98_PTYS=y
CONFIG_HVC_DRIVER=y

# warm pool: the rootfs is hot-attached as USB mass storage (vz XHCI)
CONFIG_USB_SUPPORT=y
CONFIG_USB=y
CONFIG_USB_PCI=y
CONFIG_USB_XHCI_HCD=y
CONFIG_USB_XHCI_PCI=y
CONFIG_SCSI=y
CONFIG_BLK_DEV_SD=y
CONFIG_USB_STORAGE=y

# filesystems
CONFIG_EXT4_FS=y
CONFIG_EXT4_FS_POSIX_ACL=y
CONFIG_EXT4_FS_SECURITY=y
CONFIG_OVERLAY_FS=y
CONFIG_TMPFS=y
CONFIG_TMPFS_POSIX_ACL=y
CONFIG_TMPFS_XATTR=y
CONFIG_PROC_FS=y
CONFIG_SYSFS=y
CONFIG_INOTIFY_USER=y
CONFIG_FANOTIFY=y

# network
CONFIG_NET=y
CONFIG_UNIX=y
CONFIG_INET=y
CONFIG_IPV6=y
CONFIG_PACKET=y
CONFIG_NETDEVICES=y
CONFIG_NET_CORE=y

# shrink
CONFIG_SOUND=n
CONFIG_DRM=n
CONFIG_WLAN=n
CONFIG_BT=n
CONFIG_INPUT=n
CONFIG_VT=n
