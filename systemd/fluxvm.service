[Unit]
Description=Zyvor FluxVM control plane
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
# RuntimeDirectory/StateDirectory create paths before ProtectSystem mount
# namespaces are applied. A plain ExecStartPre mkdir races and fails with
# status 226/NAMESPACE when ReadWritePaths points at missing dirs.
RuntimeDirectory=fluxvm
StateDirectory=fluxvm
ExecStartPre=/usr/bin/mkdir -p /run/netns
ExecStart=/usr/local/bin/fluxvm --config /etc/fluxvm.toml serve
Restart=on-failure
RestartSec=2
LimitMEMLOCK=infinity
# Default KillMode (control-group) would SIGTERM every QEMU child process
# along with fluxvm itself on every restart/upgrade, killing every
# running VM. `reconcile()` (fluxvm-scheduler) is explicitly designed to
# reattach to an already-running VM by checking its stored PID is still
# alive, not by re-launching it -- so a bare `process` KillMode (only the
# tracked ExecStart PID, QEMU children left alone) is exactly what lets a
# binary upgrade/restart happen without disrupting live VMs.
KillMode=process
# TAP creation needs CAP_NET_ADMIN. KVM needs /dev/kvm access. Disk
# provisioning (cloud-init/agent injection via guestfs) attaches the image
# through /dev/nbd*, which needs CAP_SYS_ADMIN for the NBD_SET_SOCK ioctl.
# CAP_NET_BIND_SERVICE + CAP_NET_RAW: the per-VM-namespace dnsmasq DHCP
# server (see fluxvm_network::netns) binds UDP/67 (a privileged port) and
# needs raw sockets for its own DHCP internals -- found live, one at a
# time: first "Permission denied" binding :67, then (after adding
# NET_BIND_SERVICE) "process is missing required capability NET_RAW".
# CAP_SYS_CHROOT: image customization (`POST /v1/images/build`'s `packages`/
# `commands`/`enable_services`) execs inside the mounted guest via
# `guestkit::Guestfs::command`, which chroots into it -- found live,
# "chroot: cannot change root directory: Operation not permitted" baking
# fluxvm-guest-agent into a base image (CAP_SYS_ADMIN alone covers the
# NBD/mount side of guestkit but not the chroot(2) syscall itself).
# CAP_DAC_OVERRIDE: creating /sys/fs/cgroup/fluxvm.slice (root's per-VM
# cgroup delegation target) is a plain mkdir on a kernfs directory whose
# mode has no write bit for anyone (dr-xr-xr-x) -- root's usual DAC bypass
# does NOT apply just because User= is root; the process's *effective*
# capability set has to actually include CAP_DAC_OVERRIDE too. Found live
# after a host reboot: every VM start/restart logged "failed to create
# cgroup for VM ... Permission denied (os error 13)", leaving
# VmRecord.cgroup_path null for every VM (breaks memory limit/usage and
# any other cgroup-based resource control) -- CAP_SYS_ADMIN alone isn't
# enough on a kernel/systemd version that enforces this strictly.
AmbientCapabilities=CAP_NET_ADMIN CAP_SYS_ADMIN CAP_NET_BIND_SERVICE CAP_NET_RAW CAP_SYS_CHROOT CAP_DAC_OVERRIDE
CapabilityBoundingSet=CAP_NET_ADMIN CAP_SYS_ADMIN CAP_NET_BIND_SERVICE CAP_NET_RAW CAP_SYS_CHROOT CAP_DAC_OVERRIDE
# virtiofsd (Secure Containers shared folders / Pod volumes) calls
# capset(2) during startup ("failed to sync capabilities with the kernel"
# under NoNewPrivileges=true). QEMU children inherit this setting; keeping
# NNP would leave virtiofs sockets present but not accepting, so guests
# die with Connection refused while the API still reports Running.
NoNewPrivileges=false
ProtectSystem=strict
# Images may live under /home during lab deploys; read-only is enough.
ProtectHome=read-only
# guestkit (disk customization/agent-token injection) needs a scratch mount
# root under /run or /tmp; PrivateTmp gives it an isolated, writable /tmp
# without opening up the host's shared one.
PrivateTmp=true
# /run/netns: per-VM network namespaces (NetworkSpec::Tap { netns: true })
# persist as bind-mount targets there -- the standard iproute2/kernel
# location, not something fluxvm can relocate.
# /var/lib/kubelet: Secure Containers shim exports the current Pod's
# volume roots (emptyDir/PVC) as extra virtiofs shares (fs1/fs2).
ReadWritePaths=/var/lib/fluxvm /run/fluxvm /var/lock /run/netns /sys/fs/bpf /var/lib/kubelet

[Install]
WantedBy=multi-user.target
